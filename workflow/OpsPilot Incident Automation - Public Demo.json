    {
      "parameters": {
        "sendTo": "prachisarode95@gmail.com",
        "subject": "=[{{$node[\"Code in JavaScript\"].json.severity}} ALERT] {{$node[\"Webhook\"].json.body.data.fields[0].value}}",
        "message": "=<h2>🚨 OpsPilot AI Incident Escalation Alert</h2>\n\n<hr>\n\n<p>\n<strong>Incident Title:</strong><br>\n{{$node[\"Webhook\"].json.body.data.fields[0].value}}\n</p>\n\n<p>\n<strong>Department:</strong><br>\n{{$node[\"Webhook\"].json.body.data.fields[1].options[0].text}}\n</p>\n\n<p>\n<strong>AI Severity:</strong><br>\n<span style=\"color:red;font-weight:bold;\">\n{{$node[\"Code in JavaScript\"].json.severity}}\n</span>\n</p>\n\n<p>\n<strong>Operational Impact:</strong><br>\n{{$node[\"Code in JavaScript\"].json.operational_impact}}\n</p>\n\n<p>\n<strong>Escalation Required:</strong><br>\n{{$node[\"Code in JavaScript\"].json.escalation_required}}\n</p>\n\n<p>\n<strong>AI Incident Summary:</strong><br>\n{{$node[\"Code in JavaScript\"].json.summary}}\n</p>\n\n<hr>\n\n<p style=\"color:gray;font-size:13px;\">\nGenerated automatically by OpsPilot AI —\nGeo-enabled Incident Intelligence Platform for Logistics & Supply Chain Operations.\n</p>",
        "options": {}

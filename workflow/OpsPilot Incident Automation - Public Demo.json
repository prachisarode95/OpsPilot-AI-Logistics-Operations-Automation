    },
    {
      "parameters": {
        "jsCode": "// ===== GET TALLY FIELDS =====\n\nconst fields =\n  $node[\"Webhook\"].json.body.data.fields;\n\n// ===== SAFE FIELD ACCESS =====\n\nconst incidentTitle =\n  fields[0]?.value || \"\";\n\nconst departmentField =\n  fields[1] || {};\n\nconst description =\n  fields[2]?.value || \"\";\n\nconst reporterName =\n  fields[3]?.value || \"\";\n\nconst reporterEmail =\n  fields[4]?.value || \"\";\n\n// ===== FIX DROPDOWN EXTRACTION =====\n\nlet department = \"\";\n\nif (\n  departmentField.type === \"DROPDOWN\"\n) {\n\n  const selectedId =\n    departmentField.value?.[0];\n\n  const matchedOption =\n    departmentField.options?.find(\n      option => option.id === selectedId\n    );\n\n  department =\n    matchedOption?.text || \"\";\n}\n\n// ===== AI RESPONSE =====\n\nconst aiResponse =\n  $json.choices?.[0]?.message?.content || \"\";\n\nconst aiText =\n  aiResponse.toLowerCase();\n\n// ===== DEFAULT VALUES =====\n\nlet severity = \"Low\";\nlet incident_type = \"Delay\";\nlet operational_impact = \"Low\";\nlet escalation_required = \"No\";\nlet summary = description;\n\n// ===== CRITICAL =====\n\nif (aiText.includes(\"critical\")) {\n\n  severity = \"Critical\";\n  incident_type = \"System Failure\";\n  operational_impact = \"High\";\n  escalation_required = \"Yes\";\n}\n\n// ===== HIGH =====\n\nelse if (aiText.includes(\"high\")) {\n\n  severity = \"High\";\n\n  if (\n    description.toLowerCase().includes(\"system\") ||\n    description.toLowerCase().includes(\"conveyor\") ||\n    description.toLowerCase().includes(\"failure\")\n  ) {\n\n    incident_type = \"System Failure\";\n\n  } else {\n\n    incident_type = \"Route Issue\";\n  }\n\n  operational_impact = \"Critical\";\n  escalation_required = \"Yes\";\n}\n\n// ===== MEDIUM =====\n\nelse if (aiText.includes(\"medium\")) {\n\n  severity = \"Medium\";\n  incident_type = \"Inventory Problem\";\n  operational_impact = \"Medium\";\n  escalation_required = \"No\";\n}\n\n// ===== LOW =====\n\nelse {\n\n  severity = \"Low\";\n  incident_type = \"Delay\";\n  operational_impact = \"Low\";\n  escalation_required = \"No\";\n}\n\n// ===== RETURN FINAL JSON =====\n\nreturn [\n  {\n    incident_title: incidentTitle,\n    department: department,\n    description: description,\n\n    reporter_name: reporterName,\n    reporter_email: reporterEmail,\n\n    incident_type: incident_type,\n    severity: severity,\n    operational_impact: operational_impact,\n    escalation_required: escalation_required,\n    summary: summary\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        80
      ],
      "id": "d82ea7f9-235b-4b23-be6b-fb76f0955fb6",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OPENROUTER_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "openai/gpt-3.5-turbo"
            },
            {
              "name": "messages",
              "value": "={{[\n  {\n    role: \"system\",\n    content: \"You are an AI operations analyst.\"\n  },\n  {\n    role: \"user\",\n    content:\n`Analyze the logistics incident and return ONLY valid JSON.\n\nRequired JSON format:\n{\n  \"incident_type\": \"\",\n  \"severity\": \"\",\n  \"operational_impact\": \"\",\n  \"escalation_required\": \"\",\n  \"summary\": \"\"\n}\n\nRules:\n\nincident_type must be EXACTLY one of:\n- Delay\n- Route Issue\n- Driver Incident\n- Inventory Problem\n- Customer Complaint\n- System Failure\n\nseverity must be EXACTLY one of:\n- Low\n- Medium\n- High\n- Critical\n\noperational_impact must be EXACTLY one of:\n- Low\n- Medium\n- High\n- Critical\n\nescalation_required must be:\n- Yes\n- No\n\nIncident Title:\n${$node[\"Webhook\"].json.body.data.fields[0].value}\n\nDepartment:\n${$node[\"Webhook\"].json.body.data.fields[1].options[0].text}\n\nIncident Description:\n${$node[\"Webhook\"].json.body.data.fields[2].value}`\n  }\n]}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        80
      ],
      "id": "fcfb0c45-df76-424a-9559-611e70130676",
      "name": "HTTP Request"
    },
